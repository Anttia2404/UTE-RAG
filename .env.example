# Copy to .env.local and fill in your Google AI Studio key.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
API_PORT=8788
APP_SECRET_KEY=
DATABASE_URL=sqlite:///./data/tuition-assistant.db
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=tuition-knowledge
APP_ENV=development
STUDENT_LLM_DAILY_LIMIT=30
STUDENT_LLM_PER_MINUTE_LIMIT=5
LLM_DAILY_CAP=800
ANSWER_CACHE_TTL_SECONDS=600
